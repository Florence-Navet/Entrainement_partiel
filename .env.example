# Copier ce fichier en .env avant de lancer `docker compose up`.
# Valeurs de développement uniquement.

NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
POSTGRES_DB=ecoda
POSTGRES_USER=ecoda_user
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_PORT=5432
# Utilisée quand l'API tourne en local (npm run dev).
# Dans Docker Compose, elle est surchargée pour pointer sur le service `db`.
DATABASE_URL=postgresql://ecoda_user:changeme_dev_only@localhost:5432/ecoda

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
